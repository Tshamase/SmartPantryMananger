<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/porcelain">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/formTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="@color/charcoal"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredient Name"
            android:textColor="@color/charcoal" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. tomatoes"
            android:textColor="@color/charcoal"
            android:textColorHint="@color/charcoal"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textColor="@color/charcoal"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/quantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 4"
            android:textColor="@color/charcoal"
            android:textColorHint="@color/charcoal"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unit"
            android:textColor="@color/charcoal"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/unitInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. pieces, g, ml"
            android:textColor="@color/charcoal"
            android:textColorHint="@color/charcoal"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expiry Date (Optional, YYYY-MM-DD)"
            android:textColor="@color/charcoal"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/expiryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2026-12-31"
            android:textColor="@color/charcoal"
            android:textColorHint="@color/charcoal"
            android:inputType="date"
            android:singleLine="true" />

        <Button
            android:id="@+id/saveIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Ingredient"
            android:textAllCaps="false"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/cancelForm"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>