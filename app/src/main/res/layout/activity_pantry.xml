
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/porcelain"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textColor="@color/charcoal"
        android:textSize="28sp"
        android:textStyle="bold" />


    <EditText
        android:id="@+id/searchIngredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search ingredients"
        android:singleLine="true"
        android:inputType="text"
        android:textColor="@color/charcoal"
        android:textColorHint="@color/secondary_text"
        android:background="@drawable/card_background"
        android:padding="12dp"
        android:layout_marginTop="12dp" />


    <Button
        android:id="@+id/addIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add ingredient"
        android:textAllCaps="false"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/emptyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty. Add ingredients to get started."
        android:textColor="@color/secondary_text"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ingredientList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/navRecipes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recipes"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

</LinearLayout>
