
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/porcelain" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recipes you can make"
        android:textColor="@color/charcoal" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Only recipes with every required ingredient in sufficient quantity appear here."
        android:textColor="@color/secondary_text" android:textSize="14sp" android:layout_marginTop="6dp" android:layout_marginBottom="10dp"/>
    <TextView android:id="@+id/emptyRecipes" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No recipes match your pantry yet. Add more ingredients to discover meals you can make."
        android:textColor="@color/secondary_text" android:gravity="center" android:padding="24dp" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recipeList" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Home" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <Button android:id="@+id/navPantry" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pantry" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <Button android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Settings" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </LinearLayout>
</LinearLayout>
