<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/porcelain"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="@color/charcoal"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Personalise your pantry experience."
        android:textColor="@color/secondary_text" />

    <Switch
        android:id="@+id/expiryAlertsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="12dp"
        android:text="Show expiring-soon alerts"
        android:textColor="@color/charcoal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/card_background"
        android:lineSpacingExtra="5dp"
        android:padding="16dp"
        android:text="Smart Pantry Manager\nVersion 1.0\n\nYour pantry is stored locally on this device. Recipe suggestions require every listed ingredient in sufficient quantity."
        android:textColor="@color/secondary_text" />

    <Button
        android:id="@+id/backHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Back to home"
        android:textAllCaps="false" />
</LinearLayout>
